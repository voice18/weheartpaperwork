rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function ownsCarrier(carrierId) {
      return signedIn() && request.auth.uid == carrierId;
    }

    function carrierAcceptsWrites(carrierId) {
      return ownsCarrier(carrierId)
        && get(/databases/$(database)/documents/carriers/$(carrierId)).data.get("deletingAccount", false) != true;
    }

    function allowedCarrierCreate() {
      return request.resource.data.keys().hasOnly([
        "companyName",
        "phoneNumber",
        "usdotNumber",
        "onboardingComplete",
        "notificationsEnabled",
        "expoPushToken",
        "notificationTokenUpdatedAt",
        "nextStepDismissed",
        "nextStepDismissedAt",
        "updatedAt"
      ]);
    }

    function allowedCarrierUpdate() {
      return request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasOnly([
          "companyName",
          "phoneNumber",
          "usdotNumber",
          "onboardingComplete",
          "notificationsEnabled",
          "expoPushToken",
          "notificationTokenUpdatedAt",
          "nextStepDismissed",
          "nextStepDismissedAt",
          "updatedAt"
        ]);
    }

    match /carriers/{carrierId} {
      allow read: if ownsCarrier(carrierId);
      allow create: if ownsCarrier(carrierId) && allowedCarrierCreate();
      allow update: if ownsCarrier(carrierId)
        && resource.data.get("deletingAccount", false) != true
        && allowedCarrierUpdate();

      match /compliance/{documentId} {
        allow read: if ownsCarrier(carrierId);
        allow write: if carrierAcceptsWrites(carrierId);
      }

      match /complianceRecords/{requirementId} {
        allow read: if ownsCarrier(carrierId);
        allow write: if carrierAcceptsWrites(carrierId);

        match /history/{recordId} {
          allow read: if ownsCarrier(carrierId);
          allow write: if carrierAcceptsWrites(carrierId);
        }
      }

      match /drivers/{driverId} {
        allow read: if ownsCarrier(carrierId);
        allow write: if carrierAcceptsWrites(carrierId);

        match /complianceRecords/{requirementId} {
          allow read: if ownsCarrier(carrierId);
          allow write: if carrierAcceptsWrites(carrierId);

          match /history/{recordId} {
            allow read: if ownsCarrier(carrierId);
            allow write: if carrierAcceptsWrites(carrierId);
          }
        }
      }

      match /customRequirements/{requirementId} {
        allow read: if ownsCarrier(carrierId);
        allow write: if carrierAcceptsWrites(carrierId);

        match /history/{recordId} {
          allow read: if ownsCarrier(carrierId);
          allow write: if carrierAcceptsWrites(carrierId);
        }
      }

      match /vehicles/{vehicleId} {
        allow read: if ownsCarrier(carrierId);
        allow write: if carrierAcceptsWrites(carrierId);

        match /complianceRecords/{requirementId} {
          allow read: if ownsCarrier(carrierId);
          allow write: if carrierAcceptsWrites(carrierId);

          match /history/{recordId} {
            allow read: if ownsCarrier(carrierId);
            allow write: if carrierAcceptsWrites(carrierId);
          }
        }
      }
    }

    match /users/{userId} {
  allow read: if signedIn()
    && request.auth.uid == userId;

  allow create: if signedIn()
    && request.auth.uid == userId
    && carrierAcceptsWrites(userId)
    && request.resource.data.keys().hasOnly([
      "email",
      "carrierId",
      "role",
      "notificationsEnabled",
      "expoPushToken",
      "expoPushTokens",
      "notificationTokenUpdatedAt",
      "updatedAt"
    ])
    && request.resource.data.carrierId == userId
    && request.resource.data.role == "owner";

  allow update: if signedIn()
    && request.auth.uid == userId
    && carrierAcceptsWrites(userId)
    && request.resource.data.carrierId == userId
    && request.resource.data.role == "owner"
    && request.resource.data
      .diff(resource.data)
      .affectedKeys()
      .hasOnly([
        "email",
        "carrierId",
        "role",
        "notificationsEnabled",
        "expoPushToken",
        "expoPushTokens",
        "notificationTokenUpdatedAt",
        "updatedAt"
      ]);
    }

    // Referral attribution and all financial records are server-authoritative.
    // Clients use callable Cloud Functions that return only their own sanitized data.
    match /referralCodes/{documentId} {
      allow read, write: if false;
    }

    match /carrierReferralCodes/{documentId} {
      allow read, write: if false;
    }

    match /referrals/{documentId} {
      allow read, write: if false;
    }

    match /referralRewards/{documentId} {
      allow read, write: if false;
    }

    match /referralRewardAdjustments/{documentId} {
      allow read, write: if false;
    }

    match /referralRewardMaturities/{documentId} {
      allow read, write: if false;
    }

    match /referralPendingDisputes/{documentId} {
      allow read, write: if false;
    }

    match /referralSummaries/{documentId} {
      allow read, write: if false;
    }

    match /referralPayouts/{documentId} {
      allow read, write: if false;
    }

    match /referralAdminAudit/{documentId} {
      allow read, write: if false;
    }

    match /referralClaimAttempts/{documentId} {
      allow read, write: if false;
    }

    match /stripeWebhookEvents/{documentId} {
      allow read, write: if false;
    }

    match /notificationPushReceipts/{documentId} {
      allow read, write: if false;
    }
  }
}
