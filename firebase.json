{
  "hosting": {
  "public": "dist",
  "cleanUrls": true,
  "redirects": [
    { "source": "/tools/mcs-150-due-date-calculator/", "destination": "/tools/mcs-150-due-date-calculator", "type": 301 }
  ],
  "ignore": [
    "firebase.json",
    "**/.*",
    "**/node_modules/**"
  ]
},
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
